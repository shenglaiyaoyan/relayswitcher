 function writeOpenCodeConfig(home, cfg) {
   const clean = { ...cfg };
   delete clean._hasComments;
   const p = configPath(home);
   fs.mkdirSync(path.dirname(p), { recursive: true });
   fs.writeFileSync(p, JSON.stringify(clean, null, 2) + '\n');
